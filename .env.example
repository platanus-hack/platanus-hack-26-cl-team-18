# Copy to .env and fill in. .env is gitignored; never commit real keys.
APP_ENV=local
LOG_LEVEL=INFO
# The sensing-to-ad pipeline runs by default in local and production.
LIVE_ADS_ENABLED=true
# Retained for simulator tooling; it does not gate live handlers.
DEMO_SIMULATOR=false
# Local, opt-in VLM enrichment; requires ANTHROPIC_API_KEY and privacy-filtered keyframes.
VLM_ENABLED=false
# JSON list of origins allowed to call the backend (Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DB_NAME=team18
DB_USER=team18
DB_PASSWORD=team18
DB_HOST=localhost
DB_PORT=5432
# scripts/migrate.py (and Render) read this one.
DATABASE_URL=postgresql://team18:team18@localhost:5432/team18

# AI module (app/modules/ai): Claude via the official anthropic SDK.
# Without a key, keyframe tagging (VLM) is off and the console shows vlm_unavailable.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low
# ANTHROPIC_TIMEOUT=20
# Warm audience AI: keyframe tagging into IAB segments + held products (AudienceClassifier)
# and speech topics the keyterm matcher missed. Off: markers, catalog cues and keyterms only
# (the console shows the VLM as degraded). Requires ANTHROPIC_API_KEY.
AUDIENCE_AI=true
# Creative: warm AI copy over targeted stock copy (docs/creative-generation.md).
CREATIVE_AI_COPY=true
# CREATIVE_COPY_TIMEOUT_S=2.5
# CREATIVE_HOURLY_BUDGET_USD=2

# ElevenLabs (ADR 0005). Voice-overs need the key AND a narrator voice id.
# Pick a Spanish voice: uv run python -m scripts.elevenlabs_voices
ELEVENLABS_API_KEY=
ELEVENLABS_NARRATOR_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# VOICEOVERS_ENABLED=true
# Hard cap on TTS characters ever spent by this install (persisted in var/). The
# account has ~10k credits; raise on purpose only.
# ELEVENLABS_CHAR_BUDGET=2000
# One-time: synthesize the demo's approved offer lines at startup (~281 credits), so
# every play has its voice from the first frame. Cached on disk afterwards.
# VOICEOVER_PREWARM=true
# Speech topics are accepted only from opted-in screens (JSON list; off by default).
# Creator tier retains STT audio at ElevenLabs: see ADR 0005 "Retention on Creator".
SPEECH_MODE_SCREENS=[]
# SPEECH_TOPIC_TTL_S=60

# Cold video only: configure a verified fal endpoint, then run `make bundle-loops`
# with explicit maximum per-request cost and total budget. Never generated on startup.
FAL_KEY=
FAL_VIDEO_MODEL=
# ffmpeg must be installed to produce kiosk-compatible H.264 720p MP4s.
